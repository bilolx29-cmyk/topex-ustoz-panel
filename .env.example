# TOPEX Ustoz Paneli — Konfiguratsiya fayli (.env)

# MongoDB Atlas Ulanish Qatori (Connection String)
# Misol: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/topex?retryWrites=true&w=majority
MONGODB_URI=

# Ma'lumotlar bazasi nomi (standart: topex)
MONGODB_DB_NAME=topex

# Server porti (lokal ishga tushirish uchun)
PORT=3000

# Agar SQLite bazasi boshqa yo'lda bo'lsa (ixtiyoriy)
# CRM_DB_PATH=
